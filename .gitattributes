# Normalize all text files to LF in the repo and on checkout.
# Prevents the WSL2/Windows CRLF churn that marks the whole tree dirty.
* text=auto eol=lf

# Binary assets — never normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary

# Lockfile is text but LF-only.
pnpm-lock.yaml text eol=lf
