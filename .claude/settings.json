{
  "permissions": {
    "allow": [
      "Bash(agent-browser:*)",
      "Bash(npx agent-browser:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
